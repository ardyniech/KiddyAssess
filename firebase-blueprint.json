{
  "entities": {
    "Student": {
      "title": "Student",
      "description": "Data profil murid",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "class": { "type": "string" },
        "semester": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["id", "name", "class", "semester", "ownerId"]
    },
    "Assessment": {
      "title": "Assessment",
      "description": "Data penilaian murid per aspek",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "scores": { 
          "type": "object",
          "description": "Map of aspectId -> Map of indicatorId -> AssessmentScale"
        },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["studentId", "scores", "ownerId"]
    },
    "Settings": {
      "title": "Settings",
      "description": "Profil sekolah dan konfigurasi aplikasi",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "principalName": { "type": "string" },
        "teacherName": { "type": "string" },
        "logoUrl": { "type": "string" },
        "showSignature": { "type": "boolean" },
        "showPhotos": { "type": "boolean" },
        "useAINarrative": { "type": "boolean" },
        "enableCloudSync": { "type": "boolean" },
        "reportNote": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["ownerId"]
    },
    "Photos": {
      "title": "Photos",
      "description": "Evidence metadata for assessments",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "aspectId": { "type": "string" },
        "indicatorId": { "type": "string" },
        "url": { "type": "string" },
        "caption": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "ownerId": { "type": "string" }
      },
      "required": ["studentId", "aspectId", "indicatorId", "url", "ownerId"]
    }
  },
  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Koleksi data murid"
    },
    "/assessments/{studentId}": {
      "schema": "Assessment",
      "description": "Koleksi data nilai per murid"
    },
    "/settings/{userId}": {
      "schema": "Settings",
      "description": "Konfigurasi profil sekolah per user"
    },
    "/photos/{photoId}": {
      "schema": "Photos",
      "description": "Koleksi foto bukti penilaian"
    }
  }
}
