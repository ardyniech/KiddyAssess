{
  "entities": {
    "KartikaTemplate": {
      "title": "Kartika Template",
      "description": "Storage for PDF report template",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "data": { "type": "string", "description": "Base64 encoded PDF" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "data", "updatedAt"]
    },
    "KanbanTask": {
      "title": "Kanban Task",
      "description": "Professional collaborative progress task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["LOW", "MEDIUM", "HIGH"] },
        "category": { "type": "string" },
        "status": { "type": "string", "enum": ["TODO", "IN_PROGRESS", "DONE"] },
        "createdBy": { "type": "string" },
        "creatorRole": { "type": "string" },
        "creatorEmail": { "type": "string" },
        "assignedTo": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "title", "description", "priority", "category", "status", "createdBy", "creatorRole", "creatorEmail", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/templates/{templateId}": {
      "schema": "KartikaTemplate",
      "description": "Store the PDF report template"
    },
    "/kanban_tasks/{taskId}": {
      "schema": "KanbanTask",
      "description": "Store school-wide collaborative Kanban tasks"
    }
  }
}
