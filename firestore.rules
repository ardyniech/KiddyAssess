rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---

    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'class', 'semester', 'ownerId', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.class is string && data.class.size() <= 100
        && data.semester is string && data.semester.size() <= 50
        && (data.updatedAt is number || data.updatedAt == request.time);
    }

    function isValidAssessment(data) {
      return data.keys().hasAll(['studentId', 'scores', 'ownerId', 'updatedAt'])
        && data.studentId is string && data.studentId.size() <= 128
        && data.scores is map
        && (data.updatedAt is number || data.updatedAt == request.time);
    }

    function isValidSettings(data) {
      return data.keys().hasAll(['ownerId', 'updatedAt'])
        && (data.updatedAt is number || data.updatedAt == request.time)
        && (data.get('name', '') is string && data.get('name', '').size() <= 200)
        && (data.get('phone', '') is string && data.get('phone', '').size() <= 20);
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['studentId', 'aspectId', 'indicatorId', 'url', 'ownerId'])
        && data.studentId is string && data.studentId.size() <= 128
        && data.aspectId is string && data.aspectId.size() <= 100
        && data.indicatorId is string && data.indicatorId.size() <= 100
        && data.url is string && data.url.size() <= 2048;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['id', 'title', 'description', 'priority', 'category', 'status', 'createdBy', 'creatorRole', 'creatorEmail', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 200
        && data.description is string && data.description.size() <= 1000
        && data.priority is string && (data.priority == 'LOW' || data.priority == 'MEDIUM' || data.priority == 'HIGH')
        && data.category is string && data.category.size() <= 100
        && data.status is string && (data.status == 'TODO' || data.status == 'IN_PROGRESS' || data.status == 'DONE')
        && data.createdBy is string && data.createdBy.size() <= 200
        && data.creatorRole is string && data.creatorRole.size() <= 50
        && data.creatorEmail is string && data.creatorEmail.size() <= 200
        && data.createdAt is number
        && data.updatedAt is number;
    }

    // --- Collections ---

    match /students/{studentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(studentId) && isValidStudent(incoming());
      allow update: if isSignedIn() && isValidStudent(incoming());
      allow delete: if isSignedIn();
    }

    match /assessments/{studentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(studentId) && isValidAssessment(incoming());
      allow update: if isSignedIn() && isValidAssessment(incoming());
      allow delete: if isSignedIn();
    }

    match /settings/{userId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && userId == request.auth.uid && isValidSettings(incoming());
      allow update: if isSignedIn() && userId == request.auth.uid && isValidSettings(incoming());
    }

    match /photos/{photoId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(photoId) && isValidPhoto(incoming());
      allow update: if isSignedIn() && isValidPhoto(incoming());
      allow delete: if isSignedIn();
    }

    match /templates/{templateId} {
      allow read, write: if true;
    }

    match /kanban_tasks/{taskId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming())
                    && incoming().id == taskId;
      allow update: if isSignedIn() && isValidId(taskId) && isValidTask(incoming())
                    && incoming().id == taskId;
      allow delete: if isSignedIn();
    }

    match /events/{eventId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(eventId);
      allow update: if isSignedIn() && isValidId(eventId);
      allow delete: if isSignedIn();
    }

    match /account_roles/{emailKey} {
      allow read, list: if isSignedIn();
      allow write: if isSignedIn() && request.auth.token.email == 'ardy.syafii@gmail.com';
    }

    match /users/{emailKey} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && request.auth.token.email == 'ardy.syafii@gmail.com';
      allow write: if isSignedIn() && (request.resource.data.email == request.auth.token.email || request.auth.token.email == 'ardy.syafii@gmail.com');
    }
  }
}
