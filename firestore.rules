rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isMaster() {
      return request.auth.uid == 'qzMszAhxzBRCd9HWElDryOtRFrU2';
    }

    function isAdmin() {
      return get(/databases/$(database)/documents/account_roles/$(request.auth.token.email.replace('.', '_'))).data.role == 'Admin';
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(data) {
      return isSignedIn() && data.ownerId == request.auth.uid;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidStudent(data) {
      return data.keys().hasAll(['id', 'name', 'kelompok', 'semester', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 200
        && data.kelompok is string && data.kelompok.size() <= 100
        && data.semester is string && data.semester.size() <= 50
        && (data.updatedAt is number || data.updatedAt == request.time);
    }

    function isValidAssessment(data) {
      return data.keys().hasAll(['studentId', 'scores', 'updatedAt'])
        && data.studentId is string && data.studentId.size() <= 128
        && data.scores is map
        && (data.updatedAt is number || data.updatedAt == request.time);
    }

    match /account_roles/{emailKey} {
      allow read: if isSignedIn();
      allow write: if isMaster();
    }

    match /staff/{staffId} {
      allow read: if isSignedIn();
      allow write: if isMaster() || isAdmin();
    }

    // --- Collections ---
    match /students/{studentId} {
      allow read: if isSignedIn();
      // Allow create/update only if ownerId matches or user is master
      allow create: if isSignedIn() && incoming().get('ownerId', request.auth.uid) == request.auth.uid;
      allow update: if isSignedIn() && (isMaster() || incoming().get('ownerId', resource.data.ownerId) == request.auth.uid || !resource.data.keys().hasAny(['ownerId']));
      allow delete: if isSignedIn() && (isMaster() || resource.data.ownerId == request.auth.uid || !resource.data.keys().hasAny(['ownerId']));
    }

    match /assessments/{studentId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().get('ownerId', request.auth.uid) == request.auth.uid;
      allow update: if isSignedIn() && (isMaster() || incoming().get('ownerId', resource.data.ownerId) == request.auth.uid);
      allow delete: if isSignedIn() && (isMaster() || resource.data.ownerId == request.auth.uid);
    }

    match /settings/{userId} {
      allow get, update: if isSignedIn() && userId == request.auth.uid;
      allow create: if isSignedIn() && userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, list: if isSignedIn(); // Allow reading profile and listing users
      allow write: if isSignedIn(); // Allow recording own login
    }
  }
}
